version=0.9.4b

[paths]
rdhome=/var/mnt/emulation/retrodeck
roms_folder=/var/mnt/emulation/retrodeck//var/mnt/emulation/library/roms
saves_folder=/var/mnt/emulation/retrodeck//var/mnt/emulation/saves
states_folder=/var/mnt/emulation/retrodeck//var/mnt/emulation/assets/states
shaders_folder=/var/mnt/emulation/retrodeck//var/mnt/emulation/assets/shaders
bios_folder=/var/mnt/emulation/retrodeck//var/mnt/emulation/library/bios
backups_folder=/var/mnt/emulation/retrodeck/backups
media_folder=/var/mnt/emulation/retrodeck//var/mnt/emulation/assets/ES-DE/media
themes_folder=/var/mnt/emulation/retrodeck//var/mnt/emulation/assets/ES-DE/themes
logs_folder=/var/mnt/emulation/retrodeck/logs
screenshots_folder=/var/mnt/emulation/retrodeck/screenshots
mods_folder=/var/mnt/emulation/retrodeck//var/mnt/emulation/assets/mods
texture_packs_folder=/var/mnt/emulation/retrodeck//var/mnt/emulation/assets/textures
borders_folder=/var/mnt/emulation/retrodeck//var/mnt/emulation/assets/borders
cheats_folder=/var/mnt/emulation/retrodeck//var/mnt/emulation/assets/cheats
sdcard=/var/mnt/emulation

[options]
power_user_warning=true
desktop_mode_warning=true
low_space_warning=true
update_check=true
update_repo=RetroDECK
branch=
update_ignore=
cloud_saves=false
multi_user_mode=false
ask_default_user=true
default_user=
developer_options=false
kiroi_ponzu=false
akai_ponzu=false
steam_sync=false
sound_effects=true
volume_effects=10
font=1
cheevos_login=false
logging_level=info
portmaster_reload_esde=true
portmaster_show=true

[cheevos]
duckstation=true
pcsx2=true
retroarch=true
ppsspp=true
dolphin=true

[cheevos_hardcore]
duckstation=true
pcsx2=true
retroarch=true
ppsspp=true
dolphin=true

[rewind]
